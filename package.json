{
  "name": "@phyzess/pappra",
  "version": "0.1.0-beta.14",
  "description": "Portable workspace knowledge and continuity for coding agents.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "bin": {
    "pappra": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "import": "./dist/collab/index.js"
    },
    "./collab/admission": {
      "types": "./dist/collab/admission.d.ts",
      "import": "./dist/collab/admission.js"
    },
    "./collab/work-plan": {
      "types": "./dist/collab/work-plan.d.ts",
      "import": "./dist/collab/work-plan.js"
    },
    "./collab/role-plan": {
      "types": "./dist/app/collab-role-plan.d.ts",
      "import": "./dist/app/collab-role-plan.js"
    },
    "./collab/role-orchestration": {
      "types": "./dist/app/collab-role-orchestration.d.ts",
      "import": "./dist/app/collab-role-orchestration.js"
    },
    "./collab/automatic-handoff": {
      "types": "./dist/app/collab-auto-handoff.d.ts",
      "import": "./dist/app/collab-auto-handoff.js"
    },
    "./collab/work-plan-inspection": {
      "types": "./dist/app/collab-work-plan.d.ts",
      "import": "./dist/app/collab-work-plan.js"
    },
    "./collab/work-execution": {
      "types": "./dist/app/collab-work-execution.d.ts",
      "import": "./dist/app/collab-work-execution.js"
    },
    "./collab/recovery": {
      "types": "./dist/app/collab-recovery.d.ts",
      "import": "./dist/app/collab-recovery.js"
    },
    "./collab/recovery-projection": {
      "types": "./dist/app/collab-recovery-projection.d.ts",
      "import": "./dist/app/collab-recovery-projection.js"
    },
    "./collab/recovery-executor": {
      "types": "./dist/app/collab-recovery-executor.d.ts",
      "import": "./dist/app/collab-recovery-executor.js"
    },
    "./collab/session-transition": {
      "types": "./dist/app/collab-session-transition.d.ts",
      "import": "./dist/app/collab-session-transition.js"
    },
    "./hosts/pi-recovery": {
      "types": "./dist/hosts/integration/pi-recovery-extension.d.ts",
      "import": "./dist/hosts/integration/pi-recovery-extension.js"
    },
    "./hosts/pi-managed": {
      "types": "./dist/hosts/pi/managed-session.d.ts",
      "import": "./dist/hosts/pi/managed-session.js"
    },
    "./hosts/pi-managed-sdk": {
      "types": "./dist/hosts/pi/managed-sdk-session.d.ts",
      "import": "./dist/hosts/pi/managed-sdk-session.js"
    },
    "./hosts/pi-session-transition": {
      "types": "./dist/hosts/integration/pi-session-transition-extension.d.ts",
      "import": "./dist/hosts/integration/pi-session-transition-extension.js"
    },
    "./hosts": {
      "types": "./dist/hosts/index.d.ts",
      "import": "./dist/hosts/index.js"
    },
    "./doctor": {
      "types": "./dist/app/doctor.d.ts",
      "import": "./dist/app/doctor.js"
    },
    "./init": {
      "types": "./dist/app/init.d.ts",
      "import": "./dist/app/init.js"
    },
    "./collaboration": {
      "types": "./dist/app/collaboration.d.ts",
      "import": "./dist/app/collaboration.js"
    },
    "./install": {
      "types": "./dist/install/index.d.ts",
      "import": "./dist/install/index.js"
    },
    "./continuity": {
      "types": "./dist/continuity/index.d.ts",
      "import": "./dist/continuity/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "import": "./dist/knowledge/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build": "tsc -p tsconfig.scripts.json && node .build/scripts/scripts/clean-build.js && tsc -p tsconfig.build.json && node .build/scripts/scripts/build-assets.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "pretest": "pnpm build && tsc -p tsconfig.test.json",
    "test": "node .build/test/scripts/run-tests.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "source:check": "pnpm build:scripts && node .build/scripts/scripts/check-source-policy.js",
    "package:check": "pnpm build && node .build/scripts/scripts/verify-package.js",
    "check": "pnpm source:check && pnpm typecheck && pnpm format:check && pnpm test && pnpm package:check",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "4.6.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phyzess/pappra.git"
  },
  "homepage": "https://github.com/phyzess/pappra",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
