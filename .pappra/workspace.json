{
  "schema": "pappra/workspace/1",
  "workspaceId": "5b583d1e-7e32-4e9b-82b3-6fbae9cb4aaf",
  "name": "pappra",
  "runtimeVersion": "0.1.0-beta.19",
  "repositories": [
    {
      "id": "pappra",
      "path": ".",
      "access": "write"
    }
  ],
  "knowledge": {
    "sources": [
      "docs"
    ],
    "newDocuments": ".pappra/knowledge",
    "taskVisibility": "private"
  },
  "code": {
    "graph": "codegraph",
    "symbols": "auto",
    "prepare": "on-demand"
  },
  "validation": [
    {
      "id": "typecheck",
      "repositoryId": "pappra",
      "executable": "pnpm",
      "args": [
        "run",
        "typecheck"
      ]
    },
    {
      "id": "test",
      "repositoryId": "pappra",
      "executable": "pnpm",
      "args": [
        "run",
        "test"
      ]
    }
  ],
  "excludes": [
    "node_modules",
    "dist",
    "coverage",
    "tmp",
    "test-results",
    ".agents/skills",
    ".pi/skills",
    ".claude/skills"
  ],
  "extensions": {}
}
